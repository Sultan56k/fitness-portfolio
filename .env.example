# Copy to .env.local and fill in. .env.local is gitignored.
#
# The site builds and runs without these — the contact form returns a clean
# 503 and routes the visitor to WhatsApp or email instead of losing the lead.
# Set them before launch so submissions actually arrive by mail.

# https://resend.com/api-keys
# Until this is set, every contact form submission returns 503 and falls back
# to the WhatsApp / email buttons. This is the single remaining blocker on the
# form being genuinely live.
RESEND_API_KEY=

# Where contact form submissions are delivered.
# Falls back to siteConfig.brand.email (hey@faisalnoor.com) when unset.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend.
# Defaults to onboarding@resend.dev, which works for testing only — mail from
# it lands in spam for most recipients, so verify the real domain before launch.
CONTACT_FROM_EMAIL=

# ---- Automated daily blog publishing (production only) -----------------
# Both are needed for scheduled posts to go live on their own. Without them
# the blog still works — you just deploy manually on the day a post is due.
# Full setup: content/blog/AUTOMATION.md

# Guards /api/cron/publish so only Vercel's scheduler can trigger a rebuild.
# Vercel sends this automatically as the Authorization header on cron calls.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The endpoint refuses to run when this is unset, rather than running open.
CRON_SECRET=

# Vercel deploy hook that rebuilds the site, so a post dated today becomes
# visible. Create at: Project → Settings → Git → Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=

# ---- Google Analytics 4 -------------------------------------------------
# GA4 measurement ID. When unset the gtag script is not loaded at all and
# every trackEvent call stays a silent no-op — which is what keeps local dev
# and preview deploys out of the production property.
# Find it at: GA4 → Admin → Data Streams → your stream → Measurement ID
# NEXT_PUBLIC_ prefix is required: this is read in the browser.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
